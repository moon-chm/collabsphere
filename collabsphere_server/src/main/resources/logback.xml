<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- requestId is populated by CallId plugin; blank when absent (startup logs) -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{requestId:-no-id}] - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <!-- Suppress noisy framework output - still visible at WARN+ -->
    <logger name="io.netty" level="WARN"/>
    <logger name="org.eclipse.jetty" level="WARN"/>
    <!-- Suppress Exposed SQL statement echo in production -->
    <logger name="Exposed" level="WARN"/>
</configuration>
