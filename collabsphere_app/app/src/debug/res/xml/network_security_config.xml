<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds only: allows cleartext HTTP and a user-installed CA (e.g. a proxy like
         Charles/mitmproxy) so local backend testing works without weakening release builds. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
