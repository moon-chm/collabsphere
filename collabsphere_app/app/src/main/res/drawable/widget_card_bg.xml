<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget card background — premium skeuomorphic warm parchment card.

  Layer stack (bottom → top):
    1. Ambient shadow: warm medium-brown, offset 5dp down, very soft edge
    2. Contact shadow: tighter warm shadow, sharper depth
    3. Card surface: warm ivory-white fill (#F5F0E8)
    4. Specular top rim: 1dp pure-white bar at top edge — lit by overhead light
    5. Hairline outer border: 1dp warm neutral stroke

  All corners 16dp for a modern premium squircle card.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Ambient drop shadow -->
    <item
        android:top="6dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#18704030" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Layer 2: Contact shadow — tighter and slightly warmer -->
    <item
        android:top="4dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#22704030" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Layer 3: Card body — warm parchment white -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5F0E8" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Layer 4: Top specular edge rim — simulates light source from above -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#44FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Layer 5: Hairline border — 1dp warm boundary -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#DDD5C8" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>
