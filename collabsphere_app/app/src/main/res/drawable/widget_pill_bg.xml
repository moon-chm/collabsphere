<?xml version="1.0" encoding="utf-8"?>
<!--
    Debossed pill badge background for widget header count badges.
    Inset socket appearance: darker inner top shadow + warm parchment fill + specular bottom rim.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Inset cavity top-left dark shadow -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#1A201612" />
        </shape>
    </item>

    <!-- Warm parchment inset fill -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#EDE8DF" />
        </shape>
    </item>

    <!-- Specular bottom-right rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

</layer-list>
