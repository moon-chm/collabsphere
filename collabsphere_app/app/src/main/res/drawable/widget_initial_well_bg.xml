<?xml version="1.0" encoding="utf-8"?>
<!--
    Debossed initial well for Workspaces widget.
    Simulates a carved-in cavity on the card surface.
    Inner shadow top-left + warm parchment bed fill + specular bottom-right rim.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cavity edge (outer dark perimeter) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1E241A15" />
        </shape>
    </item>

    <!-- Top-left dark inner shadow (cavity sink) -->
    <item
        android:top="2dp"
        android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#29201612" />
        </shape>
    </item>

    <!-- Warm sunken bed fill -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#EDE8DF"
                android:endColor="#F7F4ED" />
        </shape>
    </item>

    <!-- Specular bottom-right inner rim -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#E0FFFFFF" />
        </shape>
    </item>

</layer-list>
